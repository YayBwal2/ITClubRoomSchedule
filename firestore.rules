rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function isActive() {
      return isSignedIn() &&
        exists(profilePath()) &&
        get(profilePath()).data.get('is_active', true) == true;
    }

    function hasRole(role) {
      return isActive() && get(profilePath()).data.role == role;
    }

    function isAdmin() { return hasRole('admin'); }
    function isStaff() { return hasRole('admin') || hasRole('sse'); }

    function keepsImmutableAudit() {
      return request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.updated_by == request.auth.uid;
    }

    function validTimeWindow() {
      let d = request.resource.data;
      return d.get('start_minutes', -1) is int &&
        d.get('end_minutes', -1) is int &&
        d.start_minutes >= 0 &&
        d.end_minutes <= 1440 &&
        d.end_minutes > d.start_minutes;
    }

    function isOwnPendingProposal() {
      return hasRole('coordinator') &&
        resource.data.coordinator_id == request.auth.uid &&
        resource.data.status == 'pending';
    }

    // 1. Profiles: self read/update (no role escalation), admin full access, SSE read-only
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.role == 'coordinator' &&
        request.resource.data.created_by == request.auth.uid
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.role == resource.data.role &&
        keepsImmutableAudit()
      );
      allow delete: if isAdmin();
    }

    // 2. Rooms & Class Schedules: active users read, admin writes
    match /rooms/{roomId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /class_schedules/{scheduleId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validTimeWindow();
      allow delete: if isAdmin();
    }

    // 3. Activity Proposals: SSE view-only, coordinators manage own pending, admin approves/rejects
    match /activity_proposals/{proposalId} {
      allow read: if isStaff() || (
        isActive() &&
        (resource.data.coordinator_id == request.auth.uid || resource.data.status == 'approved')
      );
      allow create: if validTimeWindow() && (isAdmin() || (
        hasRole('coordinator') &&
        request.resource.data.coordinator_id == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.updated_by == request.auth.uid
      ));
      allow update: if isAdmin() || (
        isOwnPendingProposal() &&
        request.resource.data.coordinator_id == resource.data.coordinator_id &&
        request.resource.data.status == 'pending' &&
        keepsImmutableAudit() &&
        validTimeWindow()
      );
      allow delete: if isAdmin() || isOwnPendingProposal();
    }

    // 4. Audit Logs: admin & SSE read-only; writes reserved for Admin SDK
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
